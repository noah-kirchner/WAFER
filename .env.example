# RDS PostgreSQL/PostGIS connection -- same variable names as the Lab 7 flight_tracking .env
pgUser=
pgPassword=
pgHost=
pgPort=5432
targetDB=wafer

# Free key from https://api.census.gov/data/key_signup.html -- required as of this
# writing; api.census.gov now 302-redirects to a "missing key" page without one.
CENSUS_API_KEY=
